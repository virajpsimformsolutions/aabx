{
  "name": "aabx",
  "private": true,
  "version": "0.1.0",
  "description": "AABX monorepo",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.5.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests",
    "examples"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "release:version": "changeset version",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@types/node": "^24.0.10",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "turbo": "^2.0.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
